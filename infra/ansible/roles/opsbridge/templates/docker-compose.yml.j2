# Managed by Ansible. Images come from the registry (built by the CI pipeline).
name: opsbridge
services:
  mongo:
    image: mongo:7
    restart: unless-stopped
    volumes: [mongo-data:/data/db]
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
      interval: 10s
      retries: 12
  kafka:
    image: apache/kafka:3.9.0
    restart: unless-stopped
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
    healthcheck:
      test: ["CMD-SHELL", "/opt/kafka/bin/kafka-broker-api-versions.sh --bootstrap-server localhost:9092 >/dev/null 2>&1"]
      interval: 10s
      retries: 12
  api:
    image: {{ opsbridge_registry }}/opsbridge-api:{{ opsbridge_image_tag }}
    restart: unless-stopped
    environment:
      NODE_ENV: production
      MONGO_URL: mongodb://mongo:27017/opsbridge
      KAFKA_BROKERS: kafka:9092
      JWT_SECRET: ${JWT_SECRET}
      INTERNAL_KEY: ${INTERNAL_KEY}
      ENABLE_CHAOS: ${ENABLE_CHAOS}
    depends_on:
      mongo: { condition: service_healthy }
      kafka: { condition: service_healthy }
  worker:
    image: {{ opsbridge_registry }}/opsbridge-worker:{{ opsbridge_image_tag }}
    restart: unless-stopped
    environment:
      MONGO_URL: mongodb://mongo:27017/opsbridge
      KAFKA_BROKERS: kafka:9092
    depends_on:
      mongo: { condition: service_healthy }
      kafka: { condition: service_healthy }
  gateway:
    image: {{ opsbridge_registry }}/opsbridge-gateway:{{ opsbridge_image_tag }}
    restart: unless-stopped
    ports: ["{{ opsbridge_public_port }}:8080"]
    environment:
      UPSTREAM_URL: http://api:3000
      JWT_SECRET: ${JWT_SECRET}
      INTERNAL_KEY: ${INTERNAL_KEY}
      AUTH_RATE_LIMIT_PER_MINUTE: ${AUTH_RATE_LIMIT_PER_MINUTE}
    depends_on: [api]
volumes:
  mongo-data:
